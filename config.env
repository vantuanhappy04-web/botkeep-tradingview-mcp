# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẶC ĐỊNH (Tích hợp sẵn trong Git cho Botkeep)
# Bạn có thể sửa trực tiếp file này trên GitHub (server sẽ tự pull & cập nhật)
# hoặc ghi đè trong mục Environment của Botkeep Panel.
# ============================================================================

# 1. Tự động kiểm tra & cập nhật code mới từ GitHub khi khởi động và định kỳ
TV_AUTO_UPDATE=true
TV_UPDATE_INTERVAL_MINUTES=15
TV_GIT_REPO=https://github.com/vantuanhappy04-web/botkeep-tradingview-mcp.git
TV_GIT_BRANCH=main

# 2. Tự động bật trình duyệt Headless Chromium mở biểu đồ TradingView
TV_AUTO_LAUNCH=true
TV_CHART_URL=https://www.tradingview.com/chart/
TV_CDP_HOST=127.0.0.1
TV_CDP_PORT=9222

# 3. Bảo mật MCP (Để trống = gọi tự do không cần mật khẩu)
MCP_API_KEY=

# 4. Cookie đăng nhập TradingView (Tùy chọn - điền nếu cần Pine Script cá nhân / Alert / Layout riêng)
TV_SESSIONID=
TV_SESSIONID_SIGN=
